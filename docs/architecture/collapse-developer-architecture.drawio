        <mxCell id="bytes" value="B · BYTES · MediaGalleryCubit.bytes → MediaGalleryRepository.bytes(item)" style="shape=swimlane;html=1;horizontal=1;startSize=52;rounded=1;arcSize=8;fillColor=#F4EFFB;swimlaneFillColor=#FFFFFF;strokeColor=#7753A6;fontColor=#7753A6;fontFamily=Arial;fontSize=22;fontStyle=1;align=left;spacingLeft=20;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
