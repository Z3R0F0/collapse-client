        </mxCell>
        <mxCell id="originalCache" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;MediaRepository: ref → HTTP/cache; val → inline decode&lt;/b&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Native: cached first + stale revalidation; Web: GET on miss&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Web RAM: 64 MiB / 200 entries; reload не сохраняет originals&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Key: serverId | userId | ref; HTTP redirects disabled&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;data URI → _inlineBytes напрямую; auth только trusted origin&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF8F4;strokeColor=#24806A;strokeWidth=1.5;fontColor=#243449;fontFamily=Arial;fontSize=19;align=left;verticalAlign=middle;spacing=18;arcSize=10;shadow=0;" vertex="1" parent="bytes">
