  <diagram id="lifecycle" name="02 · Startup, session и disposal">
    <mxGraphModel dx="2600" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1800" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Bootstrap, владение экземплярами и смена сессии" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=42;fontStyle=1;fontColor=#243449;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="28" width="2500" height="55" />
        </mxCell>
        <mxCell id="subtitle" value="Три разных жизненных цикла: процесс приложения, authenticated account/session и route/pane. Закрытие route не останавливает outbox." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#617287;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="91" width="2500" height="58" />
        </mxCell>
        <mxCell id="boot" value="BOOTSTRAP · main() → initInjections() → runApp()" style="shape=swimlane;html=1;horizontal=1;startSize=52;rounded=1;arcSize=8;fillColor=#EFF5FC;swimlaneFillColor=#FFFFFF;strokeColor=#2869AD;fontColor=#2869AD;fontFamily=Arial;fontSize=22;fontStyle=1;align=left;spacingLeft=20;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="200" width="1520" height="870" />
        </mxCell>
        <mxCell id="main" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;main()&lt;/b&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;ensureInitialized() / path URL strategy&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;registerFontLicenses()&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;await initInjections(AppConfig.environment())&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF5FC;strokeColor=#2869AD;strokeWidth=1.5;fontColor=#243449;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacing=18;arcSize=10;shadow=0;" vertex="1" parent="boot">
          <mxGeometry as="geometry" x="30" y="90" width="390" height="180" />
        </mxCell>
        <mxCell id="register" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;initInjections(config)&lt;/b&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;AppConfig + await SharedPreferences: eager&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;DB / Gateway / stores / repos: lazy singletons&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Cubits: singleton / factory / factoryParam&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EFFB;strokeColor=#7753A6;strokeWidth=1.5;fontColor=#243449;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacing=18;arcSize=10;shadow=0;" vertex="1" parent="boot">
          <mxGeometry as="geometry" x="550" y="90" width="420" height="150" />
        </mxCell>
        <mxCell id="force" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;Первый locator&amp;lt;AuthRepository&amp;gt;()&lt;/b&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;changes.listen(...) в конце initInjections&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Принудительно создаёт AuthRepository,&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;ChatsRepository, AppDatabase,&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;TinodeGateway и SecureSessionStore&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Lazy registration ≠ deferred до login&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EFFB;strokeColor=#7753A6;strokeWidth=1.5;fontColor=#243449;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacing=18;arcSize=10;shadow=0;" vertex="1" parent="boot">
          <mxGeometry as="geometry" x="1080" y="90" width="400" height="210" />
        </mxCell>
        <mxCell id="e1" value="await" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2869AD;fontColor=#2869AD;fontFamily=Arial;fontSize=16;labelBackgroundColor=#FFFFFF;labelBorderColor=none;whiteSpace=nowrap;jettySize=18;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="main" target="register">
          <mxGeometry as="geometry" x="0" relative="1" />
        </mxCell>
        <mxCell id="e2" value="подписка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7753A6;fontColor=#7753A6;fontFamily=Arial;fontSize=16;labelBackgroundColor=#FFFFFF;labelBorderColor=none;whiteSpace=nowrap;jettySize=18;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="register" target="force">
          <mxGeometry as="geometry" x="0" relative="1" />
        </mxCell>
        <mxCell id="app" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;runApp(CollapseApp)&lt;/b&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;AuthRepository.restore() запущен unawaited&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;AuthCubit / SettingsCubit — через locator&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Репозитории и общие Cubits переданы .value&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;AppRouter — late final в _CollapseAppState&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF5FC;strokeColor=#2869AD;strokeWidth=1.5;fontColor=#243449;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacing=18;arcSize=10;shadow=0;" vertex="1" parent="boot">
          <mxGeometry as="geometry" x="30" y="400" width="520" height="180" />
        </mxCell>
        <mxCell id="restore" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;AuthRepository.restore()&lt;/b&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Нет saved session → signedOut; есть → chats.start → offline → reconnect&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Сеть: connect / token login → сохранить новый token → online&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;refreshTopics / flushOutbox работают асинхронно после local init&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Готовый router / online не означает, что вся история синхронизирована&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EFFB;strokeColor=#7753A6;strokeWidth=1.5;fontColor=#243449;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacing=18;arcSize=10;shadow=0;" vertex="1" parent="boot">
          <mxGeometry as="geometry" x="710" y="400" width="770" height="180" />
        </mxCell>
        <mxCell id="e3" value="initInjections завершён" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2869AD;fontColor=#2869AD;fontFamily=Arial;fontSize=16;labelBackgroundColor=#FFFFFF;labelBorderColor=none;whiteSpace=nowrap;jettySize=18;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="force" target="app">
          <mxGeometry as="geometry" x="0" relative="1">
            <Array as="points">
              <mxPoint x="1330" y="550" />
              <mxPoint x="340" y="550" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="restore()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7753A6;fontColor=#7753A6;fontFamily=Arial;fontSize=16;labelBackgroundColor=#FFFFFF;labelBorderColor=none;whiteSpace=nowrap;jettySize=18;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="restore">
          <mxGeometry as="geometry" x="0" relative="1" />
        </mxCell>
        <mxCell id="auth_events" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;changes.listen(SessionState) · синхронные побочные эффекты в composition root&lt;/b&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;MediaRepository.userId = state.userId → namespace/generation для media cache.&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;При смене account: ProfileRepository.clear(). При online: unawaited PushService.synchronize().&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Эта подписка хранится в GetIt; dispose callback только subscription.cancel().&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EFFB;strokeColor=#7753A6;strokeWidth=1.5;fontColor=#243449;fontFamily=Arial;fontSize=19;align=left;verticalAlign=middle;spacing=18;arcSize=10;shadow=0;" vertex="1" parent="boot">
          <mxGeometry as="geometry" x="30" y="660" width="1450" height="160" />
        </mxCell>
        <mxCell id="e5" value="SessionState" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7753A6;fontColor=#7753A6;fontFamily=Arial;fontSize=16;labelBackgroundColor=#FFFFFF;labelBorderColor=none;whiteSpace=nowrap;jettySize=18;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="restore" target="auth_events">
          <mxGeometry as="geometry" x="0" relative="1" />
        </mxCell>
        <mxCell id="owners" value="ВЛАДЕЛЬЦЫ / DISPOSE · НЕ СМЕШИВАТЬ" style="shape=swimlane;html=1;horizontal=1;startSize=52;rounded=1;arcSize=8;fillColor=#EDF8F4;swimlaneFillColor=#FFFFFF;strokeColor=#24806A;fontColor=#24806A;fontFamily=Arial;fontSize=22;fontStyle=1;align=left;spacingLeft=20;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1650" y="200" width="900" height="870" />
        </mxCell>
        <mxCell id="appOwner" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;_CollapseAppState → AppRouter(AuthCubit, AppConfig)&lt;/b&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;AuthCubit.stream → notifyListeners → GoRouter.redirect; отдельная подписка.&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;app.dispose(): Router subscription.cancel + GoRouter.dispose; .value не закрывает shared.&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;В lib нет locator.reset(): закрытие app не является reset всего DI-графа.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF8F4;strokeColor=#24806A;strokeWidth=1.5;fontColor=#243449;fontFamily=Arial;fontSize=19;align=left;verticalAlign=middle;spacing=18;arcSize=10;shadow=0;" vertex="1" parent="owners">
          <mxGeometry as="geometry" x="30" y="90" width="840" height="185" />
        </mxCell>
        <mxCell id="routeOwner" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;ConversationShell → ChatCubit + ChatScreen&lt;/b&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Cubit создаётся один раз в initState, key определяется account/topic.&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Info/search и resize меняют pane geometry; Cubit, draft и window остаются.&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;shell.dispose() закрывает ChatCubit; outbox остаётся в ChatsRepository.&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;MediaRoute и MediaAtlas сами создают/закрывают MediaGalleryCubit.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF8F4;strokeColor=#24806A;strokeWidth=1.5;fontColor=#243449;fontFamily=Arial;fontSize=20;align=left;verticalAlign=middle;spacing=18;arcSize=10;shadow=0;" vertex="1" parent="owners">
          <mxGeometry as="geometry" x="30" y="330" width="840" height="210" />
        </mxCell>
        <mxCell id="containerDispose" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;Явный await GetIt.reset(): callbacks в обратном порядке регистрации&lt;/b&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;subscription → AuthCubit → SettingsCubit → AuthRepository → PushService&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;→ MediaRepository → ChatsRepository → TinodeGateway → AppDatabase.&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;ChatsRepository.dispose ждёт owned work + Drift barrier перед DB close.&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;AuthRepository.dispose не делает logout и не ждёт _operation.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF8F4;strokeColor=#24806A;strokeWidth=1.5;fontColor=#243449;fontFamily=Arial;fontSize=19;align=left;verticalAlign=middle;spacing=18;arcSize=10;shadow=0;" vertex="1" parent="owners">
          <mxGeometry as="geometry" x="30" y="600" width="840" height="210" />
        </mxCell>
        <mxCell id="session" value="SESSION · AuthRepository управляет политикой; TinodeGateway — только транспортом" style="shape=swimlane;html=1;horizontal=1;startSize=52;rounded=1;arcSize=8;fillColor=#F4EFFB;swimlaneFillColor=#FFFFFF;strokeColor=#7753A6;fontColor=#7753A6;fontFamily=Arial;fontSize=22;fontStyle=1;align=left;spacingLeft=20;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1130" width="2500" height="510" />
        </mxCell>
        <mxCell id="offline" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;Disconnect / reconnect&lt;/b&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Gateway.events(disconnected) → AuthRepository&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;saved session остаётся → emit offline&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;retry/backoff → connect + token login&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Тот же account продолжает durable outbox&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EFFB;strokeColor=#7753A6;strokeWidth=1.5;fontColor=#243449;fontFamily=Arial;fontSize=20;align=left;verticalAlign=middle;spacing=18;arcSize=10;shadow=0;" vertex="1" parent="session">
          <mxGeometry as="geometry" x="30" y="120" width="530" height="190" />
        </mxCell>
        <mxCell id="logout" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;UI: await PushService.logout() → AuthCubit.signOut()&lt;/b&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;AuthRepository: ++_epoch; отменить retry; очистить _saved&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;emit signedOut сразу; disconnect socket&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;дождаться предыдущей auth operation → disconnect ещё раз&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;await chats.stop() → await store.clear()&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;signIn ждёт _signingOut barrier; кеш сообщений остаётся&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EFFB;strokeColor=#7753A6;strokeWidth=1.5;fontColor=#243449;fontFamily=Arial;fontSize=19;align=left;verticalAlign=middle;spacing=18;arcSize=10;shadow=0;" vertex="1" parent="session">
          <mxGeometry as="geometry" x="720" y="120" width="720" height="250" />
        </mxCell>
        <mxCell id="sessionGuards" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;Защита от старой async-работы&lt;/b&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;AuthRepository: epoch; ChatsRepository: scope + session generation.&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Late accepted ACK может слиться в исходный account cache.&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Старый worker не должен публиковать новые сообщения за новую сессию.&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Пауза pane/app влияет на read/playback, а не на уже сохранённый outbox.&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;GetIt instances общие; account isolation реализован внутри владельцев.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EFFB;strokeColor=#7753A6;strokeWidth=1.5;fontColor=#243449;fontFamily=Arial;fontSize=20;align=left;verticalAlign=middle;spacing=18;arcSize=10;shadow=0;" vertex="1" parent="session">
          <mxGeometry as="geometry" x="1600" y="120" width="870" height="250" />
        </mxCell>
        <mxCell id="e6" value="явный выход" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7753A6;fontColor=#7753A6;fontFamily=Arial;fontSize=16;labelBackgroundColor=#FFFFFF;labelBorderColor=none;whiteSpace=nowrap;jettySize=18;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="offline" target="logout">
          <mxGeometry as="geometry" x="0" relative="1" />
        </mxCell>
        <mxCell id="e7" value="граница сессии" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7753A6;fontColor=#7753A6;fontFamily=Arial;fontSize=16;labelBackgroundColor=#FFFFFF;labelBorderColor=none;whiteSpace=nowrap;jettySize=18;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="logout" target="sessionGuards">
          <mxGeometry as="geometry" x="0" relative="1" />
        </mxCell>
        <mxCell id="footer" value="Источники: main.dart; app.dart; dependency_injection.dart; data/auth/{auth_repository,auth_restore,auth_session,auth_reconnect}.dart; data/chat/session_lifecycle.dart · Рабочие исходники, 10.10.2026. Не runtime-трассировка и не новый прогон тестов." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#617287;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1725" width="2500" height="55" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
