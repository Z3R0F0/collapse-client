        <mxCell id="bytesCall" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;bytes(item)&lt;/b&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;capture scope + generation&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;check после async I/O&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Источник: pending / inline / ref&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EFFB;strokeColor=#7753A6;strokeWidth=1.5;fontColor=#243449;fontFamily=Arial;fontSize=20;align=left;verticalAlign=middle;spacing=18;arcSize=10;shadow=0;" vertex="1" parent="bytes">
          <mxGeometry as="geometry" x="30" y="100" width="440" height="150" />
        </mxCell>
        <mxCell id="pending" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;Pending → ChatsRepository.pendingAttachmentBytes&lt;/b&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;SQLite OutboxAttachments; локальные байты до upload&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Отдельная ветка, не HTTP-кеш MediaRepository&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF8F4;strokeColor=#24806A;strokeWidth=1.5;fontColor=#243449;fontFamily=Arial;fontSize=20;align=left;verticalAlign=middle;spacing=18;arcSize=10;shadow=0;" vertex="1" parent="bytes">
          <mxGeometry as="geometry" x="640" y="90" width="680" height="135" />
        </mxCell>
        <mxCell id="inline" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;Inline без ref/val → ChatsRepository.mediaMessage&lt;/b&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Сначала Messages; если нет — _fetch ровно seq..seq+1, limit=1&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Это обычный data path: сохраняет coverage и возможный recv&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;read не посылает; промежуточную историю не загружает&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EFFB;strokeColor=#7753A6;strokeWidth=1.5;fontColor=#243449;fontFamily=Arial;fontSize=19;align=left;verticalAlign=middle;spacing=18;arcSize=10;shadow=0;" vertex="1" parent="bytes">
