        </mxCell>
        <mxCell id="remote" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;Ref / inline val → MediaRepository&lt;/b&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;draftyReference → bytes / playable&lt;/div&gt;&lt;div style=&quot;margin-top:7px&quot;&gt;Trust origin + auth headers; bounded HTTP and cache&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EFFB;strokeColor=#7753A6;strokeWidth=1.5;fontColor=#243449;fontFamily=Arial;fontSize=20;align=left;verticalAlign=middle;spacing=18;arcSize=10;shadow=0;" vertex="1" parent="bytes">
